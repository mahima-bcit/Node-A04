<button class="nav-toggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="primary-nav" type="button">
  <span></span>
  <span></span>
  <span></span>
</button>

<nav aria-label="Primary" id="primary-nav">
  <a href="/">Home</a>
  <a href="/about">About</a>
  <a href="/projects">Projects</a>
  <a href="/contact">Contact</a>

  <% if (!isAuthenticated) { %>
    <a href="/auth/login">Login</a>
    <a href="/auth/register">Register</a>
  <% } else { %>
    <div class="nav-user-group">
      <% if (currentUser.role === "MODERATOR" || currentUser.role === "ADMIN") { %>
        <a href="/admin">Admin Dashboard</a>
        <span class="nav-role-badge"><%= currentUser.role %></span>
      <% } %>
      <span class="nav-user-name">(<%= currentUser.nickname %>)</span>
      <form method="POST" action="/auth/logout" class="nav-logout-form">
        <button type="submit" class="btn btn-secondary nav-logout-btn">Logout</button>
      </form>
    </div>
  <% } %>
</nav>